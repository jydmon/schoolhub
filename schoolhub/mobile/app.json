{
  "expo": {
    "name": "SIPlat",
    "slug": "siplat-y6qlp2of8mkzesks1ph9",
    "owner": "siplat",
    "scheme": "siplat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#4F46E5",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siplat.app",
      "buildNumber": "1",
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to sign in to SIPlat securely.",
        "NSLocationWhenInUseUsageDescription": "Drivers share their location while a route is in progress so schools and parents can track the bus. Location is never shared outside a live journey.",
        "NSCameraUsageDescription": "Attach photos on trips and scan QR codes.",
        "NSPhotoLibraryUsageDescription": "Attach photos from your library to trips and reports."
      }
    },
    "android": {
      "package": "com.siplat.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F46E5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos from your library to support requests, trips and reports.",
          "cameraPermission": "Take a photo to attach to a support request."
        }
      ]
    ],
    "runtimeVersion": { "policy": "appVersion" },
    "extra": {
      "apiUrl": "https://dev.siplat.com",
      "eas": {
        "projectId": "df829a40-9fc7-42a9-b606-c66fee8b37f7"
      }
    }
  }
}
