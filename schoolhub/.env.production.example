# --- Database (Postgres in production) ---
# Set schema.prisma datasource provider to "postgresql" and run `prisma migrate deploy`.
DATABASE_URL="postgresql://user:password@host:5432/schoolhub?schema=public"

# --- Auth ---
JWT_SECRET="REPLACE-with-a-64+char-random-secret-from-your-secret-manager"
SESSION_TTL_SECONDS="28800"

# --- App ---
APP_NAME="SIPlat"
# The app runs on the dev subdomain; the marketing site is on the apex domain.
APP_URL="https://dev.siplat.com"
NODE_ENV="production"

# Marketing-site origin(s) allowed to POST the public /api/public/subscribe form
# cross-site (comma-separated). Must match where the site is served from.
MARKETING_ORIGIN="https://siplat.com,https://www.siplat.com"

# --- AI (optional; enables live phrasing/translation) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Channels (wire live adapters in src/lib/notify.ts) ---
EMAIL_MODE="smtp"
# EMAIL_PROVIDER_KEY=""
# SMS_PROVIDER_SID=""
# SMS_PROVIDER_TOKEN=""
# PUSH_FCM_KEY=""

# --- SSO (Phase 2/3 extension points) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Shared secret for scheduled-job endpoints (e.g. pupil report release cron)
CRON_SECRET=

# Integration Hub: 32-byte key (hex or base64) for AES-256-GCM credential vault.
# Generate: openssl rand -hex 32   (REQUIRED in production; dev derives from JWT_SECRET)
INTEGRATION_ENC_KEY=
PII_ENC_KEY=            # prod: dedicated 32-byte hex key for pupil-PII field encryption (falls back to JWT_SECRET in dev)

# Invitations: HMAC key for invitation tokens/codes (falls back to JWT_SECRET if unset)
INVITE_SECRET=
CRM_SECRET=            # optional — HMAC key for CRM unsubscribe tokens (falls back to JWT_SECRET)
