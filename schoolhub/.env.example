# --- Database ---
# Dev default: local SQLite file (zero setup). For production, switch the
# datasource provider in prisma/schema.prisma to "postgresql" and point this at
# your Postgres instance, e.g. postgresql://user:pass@host:5432/schoolhub
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Secret used to sign session JWTs. MUST be replaced in production.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"
# Session lifetime in seconds (default 8h)
SESSION_TTL_SECONDS="28800"

# --- App ---
APP_NAME="SchoolHub"
APP_URL="http://localhost:3000"

# --- Email (Phase 1 stub) ---
# No SMTP is wired up in Phase 1. Verification links / reset links / notifications
# are written to the audit log and server console instead of being emailed.
EMAIL_MODE="console"

# --- Future SSO providers (Phase 1 placeholders — see src/lib/auth.ts) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Shared secret for scheduled-job endpoints (e.g. pupil report release cron)
CRON_SECRET=

# Integration Hub: 32-byte key (hex or base64) for AES-256-GCM credential vault.
# Generate: openssl rand -hex 32   (REQUIRED in production; dev derives from JWT_SECRET)
INTEGRATION_ENC_KEY=
PII_ENC_KEY=            # prod: dedicated 32-byte hex key for pupil-PII field encryption (falls back to JWT_SECRET in dev)

# Invitations: HMAC key for invitation tokens/codes (falls back to JWT_SECRET if unset)
INVITE_SECRET=
CRM_SECRET=            # optional — HMAC key for CRM unsubscribe tokens (falls back to JWT_SECRET)
